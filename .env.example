# AI Engine (Local-first)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
AI_FALLBACK_TO_TEMPLATES=True
MIN_QUALITY_SCORE=7.5

# Daily Publishing Targets
DAILY_IMAGE_POSTS_TARGET=10
